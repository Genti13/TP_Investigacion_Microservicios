{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "ruta-reportes": {
        "ClusterId": "cluster-reportes",
        "Match": { "Path": "/api/reportes/{**catch-all}" }
      },
      "ruta-dashboard": {
        "ClusterId": "cluster-dashboard",
        "Match": { "Path": "/api/dashboard/{**catch-all}" }
      },
      "ruta-oee": {
        "ClusterId": "cluster-oee",
        "Match": { "Path": "/api/oee/{**catch-all}" }
      },
      "ruta-login": {
        "ClusterId": "cluster-login",
        "Match": {
          "Path": "/api/login"
        },
        "Transforms": [
          { "PathPattern": "/login" }
        ]
      }
    },
    "Clusters": {
      "cluster-reportes": {
        "Destinations": {
          "destination1": { "Address": "http://ms-reporte:5000/" }
        }
      },
      "cluster-dashboard": {
        "Destinations": {
          "destination1": { "Address": "http://ms-dashboard:5000/" }
        }
      },
      "cluster-oee": {
        "Destinations": {
          "destination1": { "Address": "http://ms-oee:5000/" }
        }
      },
      "cluster-login": {
        "Destinations": {
          "destination1": {
            "Address": "http://ms-login:5080/"
          }
        }
      }
    }
  }
}