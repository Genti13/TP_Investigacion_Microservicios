@page
@model TP_Investigacion_Microservicios.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div style="max-width: 400px; margin: 50px auto; font-family: Arial, sans-serif;">
    <h2 style="text-align: center;">Acceso al Sistema</h2>
    <p style="text-align: center; color: gray;">Arquitectura de Microservicios</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div style="background-color: #ffdddd; color: #d8000c; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
            <strong>Error:</strong> @Model.ErrorMessage
        </div>
    }

    <form method="post" style="border: 1px solid #ccc; padding: 20px; border-radius: 8px;">
        
        <div style="margin-bottom: 15px;">
            <label asp-for="Username" style="display: block; font-weight: bold;">Usuario:</label>
            <input asp-for="Username" type="text" required style="width: 100%; padding: 8px; box-sizing: border-box;" placeholder="Ej: alumno" />
        </div>

        <div style="margin-bottom: 20px;">
            <label asp-for="Password" style="display: block; font-weight: bold;">Contraseña:</label>
            <input asp-for="Password" type="password" required style="width: 100%; padding: 8px; box-sizing: border-box;" placeholder="Ej: unlam" />
        </div>

        <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">
            Ingresar
        </button>
    </form>
</div>